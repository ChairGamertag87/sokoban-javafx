<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.image.Image?>
<?import javafx.geometry.Insets?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="ihm.sokoban.controller.MenuController"
      alignment="CENTER" spacing="0"
      styleClass="menu-root">

    <!-- Espace au-dessus du titre -->
    <Region prefHeight="40"/>

    <!-- Logo titre -->
    <ImageView fitWidth="400" preserveRatio="true" pickOnBounds="true">
        <Image url="@../images/title.png"/>
    </ImageView>

    <!-- Espace entre titre et boutons -->
    <Region prefHeight="50"/>

    <!-- Boutons du menu -->
    <VBox alignment="CENTER" spacing="12">
        <padding><Insets left="100" right="100"/></padding>

        <Button text="Niveaux Tutoriel (5 niveaux)"
                onAction="#handleTutoriel"
                styleClass="btn-menu" maxWidth="320" prefHeight="40"/>

        <Button text="Niveaux Normaux (10 niveaux)"
                onAction="#handleNormal"
                styleClass="btn-menu" maxWidth="320" prefHeight="40"/>

        <Region prefHeight="10"/>

        <Button text="Quitter"
                onAction="#handleQuitter"
                styleClass="btn-menu" maxWidth="320" prefHeight="40"/>
    </VBox>

    <!-- Espace en bas -->
    <Region VBox.vgrow="ALWAYS"/>

</VBox>

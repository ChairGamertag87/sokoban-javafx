<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.image.Image?>
<?import javafx.geometry.Insets?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="ihm.sokoban.controller.MenuController"
      alignment="CENTER" spacing="0"
      styleClass="menu-root">

    <!-- Espace flexible au-dessus -->
    <Region VBox.vgrow="ALWAYS"/>

    <!-- Logo titre -->
    <ImageView fitWidth="500" preserveRatio="true" pickOnBounds="true">
        <Image url="@../images/title.png"/>
    </ImageView>

    <Region prefHeight="60"/>

    <!-- Boutons du menu -->
    <VBox alignment="CENTER" spacing="16">
        <padding><Insets left="100" right="100"/></padding>

        <Button text="Niveaux Tutoriel (5 niveaux)"
                onAction="#handleTutoriel"
                styleClass="btn-menu" maxWidth="500" prefWidth="500" prefHeight="60"/>

        <Button text="Niveaux Normaux (10 niveaux)"
                onAction="#handleNormal"
                styleClass="btn-menu" maxWidth="500" prefWidth="500" prefHeight="60"/>

        <Button text="Charger dossier XSB..."
                onAction="#handleXSB"
                styleClass="btn-menu" maxWidth="500" prefWidth="500" prefHeight="60"/>

        <Button text="Editeur de niveaux"
                onAction="#handleEditeur"
                styleClass="btn-menu" maxWidth="500" prefWidth="500" prefHeight="60"/>

        <Region prefHeight="10"/>

        <Button text="Quitter"
                onAction="#handleQuitter"
                styleClass="btn-menu" maxWidth="500" prefWidth="500" prefHeight="60"/>
    </VBox>

    <!-- Espace flexible en bas (même hauteur qu'en haut = centrage vertical) -->
    <Region VBox.vgrow="ALWAYS"/>

</VBox>

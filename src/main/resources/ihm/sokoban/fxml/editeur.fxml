<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Spinner?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="ihm.sokoban.controller.EditeurController"
            styleClass="root-pane">

    <top>
        <VBox spacing="6">
            <padding><Insets top="10" bottom="6" left="10" right="10"/></padding>

            <!-- Controles de taille -->
            <HBox spacing="12" alignment="CENTER" styleClass="header-bar">
                <padding><Insets top="6" bottom="6" left="10" right="10"/></padding>
                <Label text="Lignes :" styleClass="label-stat"/>
                <Spinner fx:id="spinnerLignes" prefWidth="80"/>
                <Label text="Colonnes :" styleClass="label-stat"/>
                <Spinner fx:id="spinnerColonnes" prefWidth="80"/>
                <Button text="Generer" onAction="#handleGenerer" styleClass="btn-action"/>
            </HBox>

            <!-- Palette d'outils -->
            <HBox spacing="8" alignment="CENTER" styleClass="header-bar">
                <padding><Insets top="6" bottom="6" left="10" right="10"/></padding>
                <Button fx:id="btnMur" text="Mur" onAction="#handleSelectOutil" styleClass="btn-action"/>
                <Button fx:id="btnSol" text="Sol" onAction="#handleSelectOutil" styleClass="btn-action"/>
                <Button fx:id="btnCible" text="Cible" onAction="#handleSelectOutil" styleClass="btn-action"/>
                <Button fx:id="btnCaisse" text="Caisse" onAction="#handleSelectOutil" styleClass="btn-action"/>
                <Button fx:id="btnJoueur" text="Joueur" onAction="#handleSelectOutil" styleClass="btn-action"/>
                <Button fx:id="btnVide" text="Vide" onAction="#handleSelectOutil" styleClass="btn-action"/>
            </HBox>
        </VBox>
    </top>

    <center>
        <GridPane fx:id="grille" alignment="CENTER" styleClass="grid-plateau">
            <padding><Insets top="10" bottom="10" left="10" right="10"/></padding>
        </GridPane>
    </center>

    <bottom>
        <HBox spacing="10" alignment="CENTER" styleClass="footer-bar">
            <padding><Insets top="8" bottom="8" left="16" right="16"/></padding>
            <Button text="Tester" onAction="#handleTester" styleClass="btn-action"/>
            <Button text="Sauvegarder" onAction="#handleSauvegarder" styleClass="btn-action"/>
            <Button text="Effacer" onAction="#handleEffacer" styleClass="btn-action"/>
            <Button text="Retour au Menu" onAction="#handleRetour" styleClass="btn-action"/>
        </HBox>
    </bottom>

</BorderPane>
